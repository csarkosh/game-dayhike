# Shipped binaries go through Git LFS: models, ground textures, wildlife calls, the vendored
# KTX2 decoder's wasm, and the favicons. Keep this list in sync with the LFS check in .agents/skills/github-push.
*.glb  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text

*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.mjs  text eol=lf

# Shader sources: their text is what the WebGPU shader lookup keys a stage by,
# so a checkout with Windows line endings would give every stage another key.
*.fx   text eol=lf
*.glsl text eol=lf
*.wgsl text eol=lf

# The recorded shader corpus: each distinct block of shader text once, its
# bytes the block's exact text and its name a hash of them, and each stage
# as the list of its blocks (tools/wgsl/lib/corpus.mjs), written only by
# tools/wgsl/merge-corpus.mjs. Generated: kept out of the language
# statistics, its diffs folded. -whitespace: Git neither flags nor, with
# --whitespace=fix, trims its trailing spaces and blank lines, which are part
# of a stage's text. The stage files (.txt) are checked out with \n as the
# blocks (.glsl) are.
client/shaders/corpus/**                 linguist-generated=true -whitespace
tools/wgsl/test/fixtures/node-corpus/**  linguist-generated=true -whitespace
tools/wgsl/test/fixtures/corpus/**       linguist-generated=true -whitespace
client/shaders/corpus/**/*.txt           text eol=lf
tools/wgsl/test/fixtures/node-corpus/**/*.txt text eol=lf
tools/wgsl/test/fixtures/corpus/**/*.txt text eol=lf
