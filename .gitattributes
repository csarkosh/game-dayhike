# Shipped binaries go through Git LFS: models, ground textures and stills, wildlife calls, the
# intro's film, the vendored KTX2 decoder's wasm, and the favicons. Keep this list in sync with
# the LFS check in .agents/skills/github-push and tools/deploy/test/lfsAttributes.test.mjs.
*.glb  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text

*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.mjs  text eol=lf

# Shader text: the WGSL the game compiles, and the GLSL recorded for its tests
# to read (client/test/fixtures/babylon/), which they compare to the
# character: a checkout keeps their line endings.
*.glsl text eol=lf
*.wgsl text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.lock text eol=lf
