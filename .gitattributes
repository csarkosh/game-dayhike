# Shipped binaries go through Git LFS: models, ground textures and stills, wildlife calls, the
# intro's film, the vendored KTX2 decoder's wasm, and the favicons. Keep this list in sync with
# the LFS check in .agents/skills/github-push and tools/deploy/test/lfsAttributes.test.mjs.
*.glb  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text

*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.mjs  text eol=lf

# Shader sources: their text is what the WebGPU shader lookup keys a stage by,
# so a checkout with Windows line endings would give every stage another key.
# The game's .fx files are GLSL, as Babylon's are; the host's statistics take
# the extension for HLSL unless told.
*.fx   text eol=lf linguist-language=GLSL
*.glsl text eol=lf
*.wgsl text eol=lf

# The recorded shader corpus: one GLSL file a stage, its bytes the stage's
# exact text and its name a hash of them (tools/wgsl/lib/corpus.mjs), written
# only by tools/wgsl/merge-corpus.mjs. Generated: kept out of the host's
# language statistics, which count the shaders written by hand alone, and its
# diffs folded. -whitespace: Git neither flags nor, with --whitespace=fix,
# trims its trailing spaces and blank lines, which are part of a stage's text.
client/shaders/corpus/**               linguist-generated=true -whitespace
tools/wgsl/test/fixtures/node-corpus/** linguist-generated=true -whitespace
tools/wgsl/test/fixtures/corpus/**      linguist-generated=true -whitespace
