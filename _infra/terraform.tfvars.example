# GCP configuration
gcp_project_id = "fps-csarko"
gcp_region     = "us-west1"

# Public hostname. The Route53 zone must already exist.
domain_name        = "games.csarko.sh"
legacy_domain_name = "game.csarko.sh"
dns_zone_name      = "csarko.sh"

# The Google accounts that may read the admin page at
# admin.csarko.sh/game-dayhike/. Empty serves no admin routes. The sign-in is
# the admin host's, on the Firebase project csarko-sh; the default
# admin_auth_project names it and is fine.
# admin_emails = ["you@example.com"]
# admin_auth_project = "csarko-sh"

# Optional: your own addresses, or prefixes, v4 and v6. Telemetry from them is
# marked `tester` at the service, so your own play is no part of the numbers
# while its errors are kept. Only
# here, never in a tracked file: the repository is public.
# telemetry_ignore_ips = ["203.0.113.7", "2001:db8:abcd::/64"]

# Optional: a monthly budget alert for Cloud Run and Cloud Logging, the two
# services telemetry bills. Empty creates none.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_usd = 10
