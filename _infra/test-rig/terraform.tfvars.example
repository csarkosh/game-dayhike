# GCP configuration
gcp_project_id = "fps-csarko"
gcp_region     = "us-west1"
zone           = "us-west1-b"

# Machine: g2-standard-4 with its L4 (default), or n1-standard-4 with a T4.
# machine_type = "n1-standard-4"
# gpu_type     = "nvidia-tesla-t4"

# Stop the machine without destroying it (the disk is kept and billed).
# running = false

# Optional monthly budget alert. The billing account id stays in this
# git-ignored file.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
