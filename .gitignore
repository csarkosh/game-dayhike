.vite/

# Working notes kept beside a checkout; never part of the repository.
.superpowers/

# Git worktrees for isolated agent runs: a whole second checkout of this repository. ESLint's flat
# config does not read .gitignore, so eslint.config.js ignores the same path separately.
.claude/worktrees/

# Archives never belong in the tree.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.dmg

# Terraform. Plan files and state hold every resource attribute in clear;
# tfvars files hold account-specific values and addresses. A saved plan has no
# fixed name, so under _infra/ every name one is likely to get is ignored.
**/.terraform/
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.json
tfplan
plan.out
_infra/**/*.plan
_infra/**/*.plan.json
_infra/**/plan
_infra/**/plan.json
_infra/**/*.out
_infra/**/*.bin
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!_infra/terraform.tfvars.example
!_infra/test-rig-aws-windows/terraform.tfvars.example
!_infra/test-rig-gcp-windows/terraform.tfvars.example
!_infra/test-rig-scaleway-mac/terraform.tfvars.example

# Desktop release working state.
desktop/.cache/

# Firebase CLI's deploy cache.
.firebase/
